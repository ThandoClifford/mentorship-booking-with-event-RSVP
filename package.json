{
    "name": "mentorship-academy-platform",
    "description": "The Mentorship Academy Platform — React + Node.js mentorship marketplace",
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "npm run dev:all",
        "dev:frontend": "vite",
        "dev:backend": "npm --prefix backend-node run dev",
        "dev:all": "concurrently -n frontend,backend -c cyan,yellow \"npm run dev:frontend\" \"npm run dev:backend\""
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.4.1",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.8.2",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
